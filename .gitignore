# Core release allowlist. Unlisted files stay local; nothing is deleted.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/src/
/src/**
!/src/**/
!/src/**/*.py
!/configs/
/configs/**
!/configs/model_c.json
!/configs/fluent/
/configs/fluent/*
!/configs/fluent/pbm_cb_bins_15.txt
!/tests/
/tests/*
!/tests/test_fluent_table.py
!/tests/test_sectional_pbm.py
!/tests/test_cb_final_math.c
!/scripts/
/scripts/*
!/scripts/run_pipeline.ps1
!/docs/
/docs/*
!/docs/GITHUB_VSCODE.md
!/data/
/data/*
!/data/README.md
!/data/formulations.csv
!/udf/
/udf/*
!/udf/model_c_viscosity_udf.c
!/udf/model_c_pbm_final.c
!/udf/cb_final_config.h
!/udf/cb_final_math.h
!/udf/FINAL_SETUP.md
!/udf/generated/
/udf/generated/*
!/udf/generated/model_c_table.h
!/artifacts/
/artifacts/*
!/artifacts/model_c/
/artifacts/model_c/*
!/artifacts/model_c/model_c.pkl
!/artifacts/model_c/model_c_metadata.json
!/artifacts/model_c/model_c_validation.png
!/artifacts/model_c/validation_metrics.csv
!/artifacts/fluent_table/
/artifacts/fluent_table/*
!/artifacts/fluent_table/validation.json

# Additional guards, including inside allowed source directories.
**/__pycache__/
*.py[cod]
*.exe
*.dll
*.obj
*.o
*.bak
.env
.env.*
*.pem
*.key
